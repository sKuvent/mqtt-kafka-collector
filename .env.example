MQTT_URI=tcp://mosquitto:1883
MQTT_CLIENT_ID=mqtt-kafka-collector
MQTT_TOPIC=sensors/#
MQTT_USERNAME=
MQTT_PASSWORD=
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TOPIC=mqtt.raw.v1
COLLECTOR_ROLE=raw-ingress
METRICS_PREFIX=mqtt_kafka_collector
# best-effort archives QoS 0 without a delivery guarantee; reject counts and discards it.
MQTT_QOS0_POLICY=best-effort
# Set crc32 when keeping the default non-empty-key partition assignment of librdkafka.
KAFKA_PARTITIONING=murmur2
